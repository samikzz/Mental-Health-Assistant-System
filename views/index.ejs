   <script>
   var signinname=document.getElementsByClassName('signinname')[0];
   var signinpassword=document.getElementsByClassName('signinpass')[0];
   var signinbtn=document.getElementsByClassName('signinbtn')[0];
   signinbtn.addEventListener('click', () => {
   var clickAudio = new Audio();
   var errorAudio = new Audio();
   clickAudio.src = './images/mixkit-clear-mouse-clicks-2997.wav';
   errorAudio.src = './images/mixkit-alert-quick-chime-766.wav';

   var nameValue = signinname.value;
   var passwordValue = signinpassword.value;

   if (!nameValue || !passwordValue) {
      // Play error audio for missing username or password
      Swal.fire({
  icon: "error",
  title: "OOPS...",
  text: "USERNAME OR PASSWORD MISSING",
});
   } else {
      console.log("Else");
      var found = false;
      for (var i = 0; i < localStorage.length; i++) {
         var key = localStorage.key(i);
         var storedPassword = localStorage.getItem(key);
         if (key === nameValue && storedPassword === passwordValue) {
            found = true;
            break;
         }
      }
      if (found)
       {  
         login();
         async function login(){
            await Swal.fire({
  position: "middle",
  icon: "success",
  title: "Log In Successful",
  showConfirmButton: false,
  timer: 1500
});
         // Play click audio for successful login
         console.log("Playing click audio...");
         clickAudio.play();
       
         const encodedName = encodeURIComponent(nameValue);
         const encodedPassword = encodeURIComponent(passwordValue);
         const chatUrl = `http://localhost:3000/chat?name=${encodedName}&password=${encodedPassword}`;
         window.location.href = chatUrl;

         }
      } else {
         Swal.fire({
  icon: "error",
  title: "OOPS...",
  text: "WRONG USERNAME OR PASSWORD",
});
      }
   }
});


